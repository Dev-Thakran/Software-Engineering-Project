@startuml
title La Extravaganza — Sequence Diagram: Customer Booking Flow

skinparam shadowing false
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceArrowThickness 1.2
skinparam sequenceParticipantBorderThickness 1
skinparam sequenceLifeLineBorderThickness 1
skinparam nodesep 30

actor Customer as C
participant "Browser\n(Frontend JS)" as B
participant "Express Server\n(server.js)" as E
participant "Auth Middleware\n(auth.middleware.js)" as M
participant "Room Controller\n(room.controller.js)" as RC
participant "Booking Controller\n(booking.controller.js)" as BC
participant "Payment Controller\n(payment.controller.js)" as PC
participant "Room Repository\n(room.repository.js)" as RR
participant "Booking Repository\n(booking.repository.js)" as BR
database "JSON Data Store\n(rooms.json\nbookings.json)" as DB

== Step 1: Customer selects a room ==

C -> B : Clicks "Reserve" on Room 102
B -> E : GET /rooms/102
E -> RC : getOne(req, res)
RC -> RR : findById("102")
RR -> DB : fs.readFileSync(rooms.json)
DB --> RR : rooms array
RR --> RC : room object
RC --> B : 200 OK — room JSON
B --> C : Renders booking form\nwith room details

== Step 2: Customer submits dates and continues to payment ==

C -> B : Enters check-in, check-out,\nguests — clicks Continue
B -> B : Validates dates client-side\n(checkout > checkin, nights ≥ 1)
B --> C : Shows Step 2 — Payment form

== Step 3: Customer submits payment ==

C -> B : Enters card details\n— clicks Pay $230
B -> B : Validates card format\n(16 digits, MM/YY, CVV)
B -> E : POST /payment/process\n{ cardNumber, expiry, cvv, amount }\nAuthorization: Bearer <token>
E -> M : authenticate(req, res, next)
M -> M : jwt.verify(token, SECRET)

alt Invalid or missing token
    M --> B : 401 Unauthorized\n{ error: "Invalid token" }
    B --> C : Shows error — redirects to login
else Valid token
    M -> PC : processPayment(req, res)
    PC -> PC : Validates 16-digit card\nExpiry MM/YY format\nCVV 3-4 digits
    alt Validation fails
        PC --> B : 400 Bad Request\n{ error: "Card number must be 16 digits" }
        B --> C : Shows inline error message
    else Validation passes
        PC --> B : 200 OK\n{ success: true, transactionId: "TXN..." }
    end
end

== Step 4: Create booking ==

B -> E : POST /bookings\n{ roomId, checkIn, checkOut, guests }\nAuthorization: Bearer <token>
E -> M : authenticate(req, res, next)
M -> M : jwt.verify(token, SECRET)
M -> M : requireRole("customer")

alt Wrong role (staff or manager)
    M --> B : 403 Forbidden\n{ error: "Access denied" }
    B --> C : Shows access denied error
else Customer role confirmed
    M -> BC : create(req, res)
    BC -> RR : findById(roomId)
    RR -> DB : fs.readFileSync(rooms.json)
    DB --> RR : rooms array
    RR --> BC : room object

    alt Room not available
        BC --> B : 409 Conflict\n{ error: "Room is not available" }
        B --> C : Shows room unavailable error
    else Room is available
        BC -> BC : Calculates nights and total\nBuilds booking object
        BC -> BR : save(booking)
        BR -> DB : fs.writeFileSync(bookings.json)
        DB --> BR : Write confirmed
        BC -> RR : update(roomId, { status: "occupied" })
        RR -> DB : fs.writeFileSync(rooms.json)
        DB --> RR : Write confirmed
        BC --> B : 201 Created\n{ id: "b...", status: "pending", total: 230 }
        B --> C : Shows confirmation\n"Booking confirmed! Ref: b..."\nRedirects to My Bookings
    end
end

@enduml
