@startuml
title La Extravaganza — Component Diagram

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 11
skinparam nodesep 60
skinparam ranksep 60

' =========================
' Presentation Layer
' =========================
package "Presentation Layer" {

  component "Browser Client\nHTML / Tailwind CSS / JavaScript\nfrontend/pages/*.html" as Browser

  component "Static Files\nHTML, CSS, JS, Images\nfrontend/" as StaticFiles

  Browser -[hidden]down-> StaticFiles
}

' =========================
' Backend Layer
' =========================
package "Backend Layer" {

  component "Express Server\nNode.js / Express 5\nbackend/server.js" as Express

  component "Auth Middleware\nJWT Validation + Role Check\nbackend/middleware/auth.middleware.js" as Middleware

  component "Route Layer\nauth.routes\nroom.routes\nbooking.routes\npayment.routes\nbackend/routes/*.routes.js" as Routes

  component "Controller Layer\nauth / room / booking / payment\nbackend/controllers/*.controller.js" as Controllers

  component "Repository Layer\nuser / room / booking\nbackend/repositories/*.repository.js" as Repositories

  database "JSON Data Store\nusers.json\nrooms.json\nbookings.json\nreviews.json\nbackend/data/*.json" as DataStore

  Express -[hidden]down-> Middleware
  Middleware -[hidden]down-> Routes
  Routes -[hidden]down-> Controllers
  Controllers -[hidden]down-> Repositories
  Repositories -[hidden]down-> DataStore
}

' =========================
' Horizontal Alignment
' =========================
Browser -[hidden]- Express
StaticFiles -[hidden]- Middleware

' =========================
' Relationships
' =========================
Browser --> Express : HTTP Requests\n(fetch / API calls)

Express --> StaticFiles : Serves static files
StaticFiles --> Browser : HTML / CSS / JS

Express --> Middleware : Protected routes

Middleware --> Routes : Validated request

Routes --> Controllers : Calls handler

Controllers --> Repositories : Read / write data

Repositories --> DataStore : fs.readFileSync()\nfs.writeFileSync()

@enduml