@startuml
title La Extravaganza — Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70

' =========================
' Base User Class
' =========================
class User {
  - id: String
  - name: String
  - email: String
  - password: String
  - role: Role

  + login(): Token
  + register(): void
}

' =========================
' User Types
' =========================
class Customer {
  + browseRooms(): Room[]
  + createBooking(): Booking
  + viewBookings(): Booking[]
  + submitReview(): Review
}

class Staff {
  + viewAllBookings(): Booking[]
  + updateBookingStatus(): void
  + checkInGuest(): Checkin
  + checkOutGuest(): void
}

class Manager {
  + addRoom(): Room
  + editRoom(): Room
  + deleteRoom(): void
  + viewAnalytics(): Stats
}

' =========================
' Core Domain Classes
' =========================
class Room {
  - id: String
  - floor: Number
  - type: String
  - price: Number
  - status: RoomStatus
  - description: String
  - image: String

  + getAll(): Room[]
  + findById(): Room
  + update(): Room
}

class Booking {
  - id: String
  - userId: String
  - roomId: String
  - checkIn: String
  - checkOut: String
  - nights: Number
  - total: Number
  - status: BookingStatus

  + save(): Booking
  + update(): Booking
}

class Payment {
  - cardNumber: String
  - expiry: String
  - cvv: String
  - amount: Number
  - transactionId: String

  + processPayment(): Result
}

class Review {
  - id: String
  - guestName: String
  - roomId: String
  - rating: Number
  - title: String
  - comment: String
  - date: String

  + save(): Review
}

' =========================
' Enums
' =========================
enum Role {
  customer
  staff
  manager
}

enum RoomStatus {
  available
  occupied
  pending
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  checked_out
}

' =========================
' Inheritance
' =========================
User <|-- Customer
User <|-- Staff
User <|-- Manager

' =========================
' Associations
' =========================
Customer "1" --> "0..*" Booking : creates
Booking --> "1" Room : references
Room --> "0..*" Review : has
Booking --> "1" Payment : processed by

' =========================
' Dependencies
' =========================
Manager ..> Room : manages (CRUD)
Staff ..> Booking : updates status

@enduml