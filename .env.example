# Copy this file to .env and fill in real values. .env is git-ignored.

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=3000

# Where npm run seed:demo backs up the current data before replacing it
# (default: the computer's temp folder), e.g. D:/hotel-data-backups
# DATA_BACKUP_DIR=

# --- AI assistant ---------------------------------------------
# Easiest: run  npm run setup:ai  and it fills this section in for you.
#
# Aria runs on a hosted AI model. Set at least one key below:
#   GROQ_API_KEY       free tier, very fast     https://console.groq.com/keys
#   GEMINI_API_KEY     free tier                https://aistudio.google.com/apikey
#   ANTHROPIC_API_KEY  Claude, paid per message https://console.anthropic.com
# Keys are secret: they stay in .env, which git ignores. Never commit them.

# auto = use whichever key is set (Claude, then Groq, then Gemini), moving
# on to the next one if a service is busy. Or force one: groq, gemini, claude
AI_PROVIDER=auto

# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model overrides (defaults: openai/gpt-oss-120b,
# gemini-flash-lite-latest, claude-opus-5)
# GROQ_MODEL=
# GEMINI_MODEL=
# CLAUDE_MODEL=
